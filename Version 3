import datetime

first_name = str(input("Enter your first name: "))
last_name = str(input("Enter your last name: "))
section = str(input("Enter your section: "))
event_name = str(input("Enter event name: "))
year = str(input("Enter event year: "))
month = str(input("Enter event month: "))
day = str(input("Enter event day: "))

full_name = first_name.strip().title() + " " + last_name.strip().title()

event_date = datetime.date(int(year), int(month), int(day))

print("\nStudent Event Registration Summary")
print("Name:", full_name)
print("Name Code:", full_name.upper())
print("Section:", section.strip().upper())
print("Event:", event_name.strip().title())
print("Event Date:", event_date.strftime("%B %d, %Y"))
print("Language Used: Python")
print("String Feature Used: strip(), title(), upper()")
print("Date/Time Feature Used: datetime")

print("\nRegistration record created successfully.")
