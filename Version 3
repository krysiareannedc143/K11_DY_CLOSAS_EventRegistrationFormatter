import datetime

first_name = input("Enter student first name: ")
last_name = input("Enter student last name: ")
section = input("Enter section: ")
event_name = input("Enter event name: ")
event_year = input("Enter event year: ")
event_month = input("Enter event month: ")
event_day = input("Enter event day: ")

first_name = first_name.strip()
last_name = last_name.strip()
full_name = first_name + " " + last_name
section = section.strip().upper()
event_name = event_name.strip().title()

event_year = event_year.strip()
event_month = event_month.strip().capitalize()
event_day = event_day.strip()

full_date = event_month + " " + event_day + " " + event_year
formatted_date = datetime.datetime.strptime(full_date, "%B %d %Y")

print()
print("Student Event Registration Summary")
print()
print("Name:", full_name.title())
print("Name Code:", full_name.upper())
print("Section:", section)
print("Event:", event_name)
print("Event Date:", formatted_date.strftime("%B"), str(formatted_date.day) + ",", formatted_date.year)
print("Language Used: Python")
print("String Feature Used: strip(), title(), upper()")
print("Date/Time Feature Used: datetime")
print()
print("Registration record created successfully.")
